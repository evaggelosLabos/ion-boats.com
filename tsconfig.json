{
  "compilerOptions": {
    /* Language & Environment */
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],

    /* JS & Emit */
    "allowJs": true,
    "noEmit": true,
    "incremental": true,

    /* Type Safety */
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,

    /* Module Resolution */
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,

    /* JSX */
    "jsx": "react-jsx",

    /* Next.js */
    "plugins": [
      {
        "name": "next"
      }
    ],

    /* Path Aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },

  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "models/**/*.ts",
    "middleware.ts",
    "next.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],

  "exclude": ["node_modules"]
}
